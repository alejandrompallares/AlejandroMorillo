---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p class="hand">Built by hand (and by code) in Madrid.</p>
    <p class="site-footer__meta">© {year} Alejandro Morillo</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-3);
    border-top: var(--border) solid var(--ink);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1);
    font-size: 0.95rem;
  }

  .site-footer__meta {
    font-family: var(--face-mono);
    font-size: 0.82rem;
    opacity: 0.75;
  }
</style>
